{
  "id": "after_start",
  "name": "After Start",
  "items": [
    {
      "label": "Anti Ice",
      "challenge": "anti_ice.ogg",
      "response": ["engines on", "engines on wings on", "off", "set and checked"],
      "incorrect": "are_you_sure.ogg",
      "validations": [
        {
          "when": { "responses": ["off"] },
          "checks": [
            { "type": "store", "store": "takeoff.antiIce", "equals": "off" },
            { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_ENG1_ANTI_ICE)", "expected": 0 },
            { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_ENG2_ANTI_ICE)", "expected": 0 },
            { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_WING_ANTI_ICE)", "expected": 0 }
          ]
        },
        {
          "when": { "responses": ["engines on"] },
          "checks": [
            { "type": "store", "store": "takeoff.antiIce", "equals": "oneng" },
            { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_ENG1_ANTI_ICE)", "expected": 1 },
            { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_ENG2_ANTI_ICE)", "expected": 1 },
            { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_WING_ANTI_ICE)", "expected": 0 }
          ]
        },
        {
          "when": { "responses": ["engines on wings on"] },
          "checks": [
            { "type": "store", "store": "takeoff.antiIce", "equals": "onengwing" },
            { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_ENG1_ANTI_ICE)", "expected": 1 },
            { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_ENG2_ANTI_ICE)", "expected": 1 },
            { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_WING_ANTI_ICE)", "expected": 1 }
          ]
        },
        {
          "when": { "responses": ["set and checked"] },
          "checks": [
            {
              "type": "any",
              "groups": [
                [
                  { "type": "store", "store": "takeoff.antiIce", "equals": "off" },
                  { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_ENG1_ANTI_ICE)", "expected": 0 },
                  { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_ENG2_ANTI_ICE)", "expected": 0 },
                  { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_WING_ANTI_ICE)", "expected": 0 }
                ],
                [
                  { "type": "store", "store": "takeoff.antiIce", "equals": "oneng" },
                  { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_ENG1_ANTI_ICE)", "expected": 1 },
                  { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_ENG2_ANTI_ICE)", "expected": 1 },
                  { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_WING_ANTI_ICE)", "expected": 0 }
                ],
                [
                  { "type": "store", "store": "takeoff.antiIce", "equals": "onengwing" },
                  { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_ENG1_ANTI_ICE)", "expected": 1 },
                  { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_ENG2_ANTI_ICE)", "expected": 1 },
                  { "type": "simvar", "var": "(L:S_OH_PNEUMATIC_WING_ANTI_ICE)", "expected": 1 }
                ]
              ]
            }
          ]
        }
      ]
    },
    {
      "challenge": "ecam_status.ogg",
      "response": ["checked", "set and checked"],
      "label": "ECAM Status"
    },
    {
      "challenge": "pitch_trim.ogg",
      "response": ["percent", "set and checked"],
      "label": "Pitch Trim",
      "incorrect": "are_you_sure.ogg",
      "cg_confirmation": true
    },
    {
      "challenge": "rudder_trim.ogg",
      "response": ["neutral", "zero", "set and checked"],
      "label": "Rudder Trim",
      "incorrect": "are_you_sure.ogg",
      "validations": [
        {
          "when": { "always": true },
          "checks": [{ "type": "simvar", "var": "(L:N_FC_RUDDER_TRIM)", "expected": 0 }]
        }
      ]
    },
    {
      "challenge": "ground_clearance.ogg",
      "response": ["received", "set and checked"],
      "label": "Ground Clearance",
      "copilot_response": "received.ogg"
    }
  ],
  "completion": "after_start_checklist_completed.ogg"
}
