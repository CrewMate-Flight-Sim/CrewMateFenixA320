{
  "id": "taxi",
  "name": "Taxi Checklist",
  "items": [
    {
      "challenge": "flight_controls.ogg",
      "response": ["checked", "set and checked"],
      "label": "Flight Controls",
      "copilot_response": "checked.ogg"
    },
    {
      "challenge": "flap_settings.ogg",
      "response": ["config one plus f", "config two", "config three", "set and checked"],
      "label": "Flap Settings",
      "validations": [
        {
          "when": { "responses": ["config one plus f"] },
          "checks": [
            { "type": "simvar", "var": "(L:S_FC_FLAPS)", "expected": 1 },
            { "type": "store", "store": "takeoff.flaps", "equals": "1" }
          ],
          "copilot_response": "config_1_plus_f.ogg"
        },
        {
          "when": { "responses": ["config two"] },
          "checks": [
            { "type": "simvar", "var": "(L:S_FC_FLAPS)", "expected": 2 },
            { "type": "store", "store": "takeoff.flaps", "equals": "2" }
          ],
          "copilot_response": "config_2.ogg"
        },
        {
          "when": { "responses": ["config three"] },
          "checks": [
            { "type": "simvar", "var": "(L:S_FC_FLAPS)", "expected": 3 },
            { "type": "store", "store": "takeoff.flaps", "equals": "3" }
          ],
          "copilot_response": "config_3.ogg"
        },
        {
          "when": { "responses": ["set and checked"] }
        }
      ]
    },
    {
      "challenge": "radar.ogg",
      "response": ["on", "set and checked"],
      "label": "Radar"
    }
  ],
  "completion": "taxi_checklist_completed.ogg"
}
