{
  "id": "cockpit_prep",
  "name": "Cockpit Preparation",
  "steps": [
    {
      "label": "APU Bleed ON",
      "read": "(L:S_OH_PNEUMATIC_APU_BLEED)",
      "on": "1 (>L:S_OH_PNEUMATIC_APU_BLEED)",
      "expect": 1,
      "only_if": {
        "read": "(L:I_OH_ELEC_APU_START_U)",
        "one_of": [1]
      }
    },
    {
      "label": "Table",
      "read": "(L:S_TRAY_TABLE_FO)",
      "on": "1 (>L:S_TRAY_TABLE_FO)",
      "expect": 1
    },
    {
      "label": "FO CSTR",
      "read": "(L:I_FCU_EFIS2_CSTR)",
      "on": "S_FCU_EFIS2_CSTR",
      "expect": 1,
      "press": true
    },
    {
      "label": "FO VOR 1",
      "read": "(L:S_FCU_EFIS2_NAV1)",
      "on": "2 (>L:S_FCU_EFIS2_NAV1)",
      "expect": 2
    },
    {
      "label": "FO VOR 2",
      "read": "(L:S_FCU_EFIS2_NAV2)",
      "on": "2 (>L:S_FCU_EFIS2_NAV2)",
      "expect": 2
    },
    {
      "label": "FO ND ARC",
      "read": "(L:S_FCU_EFIS2_ND_MODE)",
      "on": "3 (>L:S_FCU_EFIS2_ND_MODE)",
      "expect": 3
    },
    {
      "label": "FO ND Range",
      "read": "(L:S_FCU_EFIS2_ND_ZOOM)",
      "on": "0 (>L:S_FCU_EFIS2_ND_ZOOM)",
      "expect": 0
    },
    {
      "label": "Oxygen Mask Cover",
      "read": "(L:S_OXYGEN_MASK_COVER_FO)",
      "on": "1 (>L:S_OXYGEN_MASK_COVER_FO)",
      "expect": 1
    },
    {
      "label": "Oxygen Mask Test",
      "read": "(L:S_OXYGEN_MASK_1_TEST_FO)",
      "on": "S_OXYGEN_MASK_1_TEST_FO",
      "expect": 0,
      "press": true,
      "hold_ms": 3000,
      "skip_verify": true
    },
    {
      "label": "Oxygen Mask Cover",
      "read": "(L:S_OXYGEN_MASK_COVER_FO)",
      "on": "0 (>L:S_OXYGEN_MASK_COVER_FO)",
      "expect": 0
    }
  ]
}
