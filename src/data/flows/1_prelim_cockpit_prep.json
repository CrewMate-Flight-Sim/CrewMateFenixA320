{
  "id": "prelim_cockpit_prep",
  "name": "Preliminary Cockpit Preparation",
  "steps": [
    { "label": "Weather Radar OFF", "read": "(L:S_WR_SYS)", "on": "1 (>L:S_WR_SYS)", "expect": 1 },
    { "label": "Predictive Windshear OFF", "read": "(L:S_WR_PRED_WS)", "on": "0 (>L:S_WR_PRED_WS)", "expect": 0 },
    { "label": "Engine 1 Master OFF", "read": "(L:S_ENG_MASTER_1)", "on": "0 (>L:S_ENG_MASTER_1)", "expect": 0 },
    { "label": "Engine 2 Master OFF", "read": "(L:S_ENG_MASTER_2)", "on": "0 (>L:S_ENG_MASTER_2)", "expect": 0 },
    { "label": "Engine Mode NORM", "read": "(L:S_ENG_MODE)", "on": "1 (>L:S_ENG_MODE)", "expect": 1 },
    { "label": "Gear Lever DOWN", "read": "(L:S_MIP_GEAR)", "on": "1 (>L:S_MIP_GEAR)", "expect": 1 },
    { "label": "Wiper Captain OFF", "read": "(L:S_MISC_WIPER_CAPT)", "on": "0 (>L:S_MISC_WIPER_CAPT)", "expect": 0 },
    { "label": "Wiper FO OFF", "read": "(L:S_MISC_WIPER_FO)", "on": "0 (>L:S_MISC_WIPER_FO)", "expect": 0 },
    { "label": "Battery 1 OFF", "read": "(L:S_OH_ELEC_BAT1)", "on": "0 (>L:S_OH_ELEC_BAT1)", "expect": 0 },
    {
      "label": "Battery 2 OFF",
      "read": "(L:S_OH_ELEC_BAT2)",
      "on": "0 (>L:S_OH_ELEC_BAT2)",
      "expect": 0,
      "wait_ms": 3000
    },
    { "label": "Battery 1 AUTO", "read": "(L:S_OH_ELEC_BAT1)", "on": "1 (>L:S_OH_ELEC_BAT1)", "expect": 1 },
    { "label": "Battery 2 AUTO", "read": "(L:S_OH_ELEC_BAT2)", "on": "1 (>L:S_OH_ELEC_BAT2)", "expect": 1 },
    {
      "label": "External Power ON",
      "read": "(L:I_OH_ELEC_EXT_PWR_L)",
      "on": "S_OH_ELEC_EXT_PWR",
      "expect": 1,
      "press": true,
      "only_if": { "read": "(L:I_OH_ELEC_EXT_PWR_U)", "one_of": [1] }
    },
    { "label": "RMP 2 ON", "read": "(L:S_PED_RMP2_POWER)", "on": "1 (>L:S_PED_RMP2_POWER)", "expect": 1 },
    {
      "label": "ACP 2 VHF 1 Volume",
      "read": "(L:A_ASP2_VHF_1_VOLUME)",
      "on": "0.5 (>L:A_ASP2_VHF_1_VOLUME)",
      "expect": 0.5,
      "only_if": { "read": "(L:A_ASP2_VHF_1_VOLUME)", "one_of": [0] }
    },
    {
      "label": "APU Fire Test",
      "read": "(L:S_OH_FIRE_APU_TEST)",
      "on": "S_OH_FIRE_APU_TEST",
      "expect": 0,
      "press": true,
      "hold_ms": 2000,
      "skip_verify": true,
      "sound_on_execute": "fire_test.ogg"
    },
    {
      "label": "APU Master ON",
      "read": "(L:S_OH_ELEC_APU_MASTER)",
      "on": "1 (>L:S_OH_ELEC_APU_MASTER)",
      "expect": 1,
      "wait_ms": 3000
    },
    {
      "label": "APU Start",
      "read": "(L:I_OH_ELEC_APU_START_L)",
      "on": "S_OH_ELEC_APU_START",
      "expect": 1,
      "press": true,
      "only_if": { "read": "(L:I_OH_ELEC_APU_START_U)", "one_of": [0] }
    },
    { "label": "IR 1 NAV", "read": "(L:S_OH_NAV_IR1_MODE)", "on": "1 (>L:S_OH_NAV_IR1_MODE)", "expect": 1 },
    { "label": "IR 2 NAV", "read": "(L:S_OH_NAV_IR2_MODE)", "on": "1 (>L:S_OH_NAV_IR2_MODE)", "expect": 1 },
    { "label": "IR 3 NAV", "read": "(L:S_OH_NAV_IR3_MODE)", "on": "1 (>L:S_OH_NAV_IR3_MODE)", "expect": 1 },
    {
      "label": "Dome Light",
      "read": "(L:S_OH_INT_LT_DOME)",
      "on": "2 (>L:S_OH_INT_LT_DOME)",
      "expect": 2,
      "only_if": { "read": "(E:TIME OF DAY)", "one_of": [0, 2, 3] }
    },
    {
      "label": "ECAM ENG Page",
      "read": "(L:I_ECAM_ENGINE)",
      "on": "S_ECAM_ENGINE",
      "expect": 1,
      "press": true,
      "wait_ms": 2000
    },
    {
      "label": "ECAM HYD Page",
      "read": "(L:I_ECAM_HYD)",
      "on": "S_ECAM_HYD",
      "expect": 1,
      "press": true,
      "wait_ms": 2000
    },
    {
      "label": "ECAM DOOR Page",
      "read": "(L:I_ECAM_DOOR)",
      "on": "S_ECAM_DOOR",
      "expect": 1,
      "press": true,
      "wait_ms": 2000
    },
    { "label": "ECAM DOOR Page off", "read": "(L:I_ECAM_DOOR)", "on": "S_ECAM_DOOR", "expect": 0, "press": true },
    {
      "label": "Parking Brake ON",
      "read": "(L:S_MIP_PARKING_BRAKE)",
      "on": "1 (>L:S_MIP_PARKING_BRAKE)",
      "expect": 1
    }
  ]
}
