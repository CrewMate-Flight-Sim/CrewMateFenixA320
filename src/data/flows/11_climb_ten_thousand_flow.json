{
  "id": "climb_ten_thousand_flow",
  "name": "Climb Ten Thousand Flow",
  "steps": [
    {
      "label": "Landing Light Left",
      "read": "(L:S_OH_EXT_LT_LANDING_L)",
      "on": "0 (>L:S_OH_EXT_LT_LANDING_L)",
      "expect": 0
    },
    {
      "label": "Landing Light Right",
      "read": "(L:S_OH_EXT_LT_LANDING_R)",
      "on": "0 (>L:S_OH_EXT_LT_LANDING_R)",
      "expect": 0
    },
    {
      "label": "FO ARPT",
      "read": "(L:I_FCU_EFIS2_ARPT)",
      "on": "S_FCU_EFIS2_ARPT",
      "press": true,
      "expect": 1
    },
    {
      "label": "ND SET",
      "read": "(L:S_FCU_EFIS2_ND_ZOOM)",
      "on": "2 (>L:S_FCU_EFIS2_ND_ZOOM)",
      "expect": 2
    },
    {
      "label": "Table",
      "read": "(L:S_TRAY_TABLE_FO)",
      "on": "1 (>L:S_TRAY_TABLE_FO)",
      "expect": 1
    }
  ]
}
