{
  "id": "after_start_e2",
  "name": "After Start Engine 2",
  "steps": [
    {
      "label": "Ignition Knob",
      "read": "(L:INI_IGNITION_KNOB)",
      "on": "1 (>L:INI_IGNITION_KNOB)",
      "expect": 1
    },
    {
      "label": "Engine 1 Anti Ice",
      "read": "(L:S_OH_PNEUMATIC_ENG1_ANTI_ICE)",
      "on": "{anti_ice_eng1_cmd}",
      "expect": "{anti_ice_eng1_expect}"
    },
    {
      "label": "Engine 2 Anti Ice",
      "read": "(L:S_OH_PNEUMATIC_ENG2_ANTI_ICE)",
      "on": "{anti_ice_eng2_cmd}",
      "expect": "{anti_ice_eng2_expect}"
    },
    {
      "label": "Wing Anti Ice",
      "read": "(L:S_OH_PNEUMATIC_WING_ANTI_ICE)",
      "on": "{anti_ice_wing_cmd}",
      "expect": "{anti_ice_wing_expect}"
    }
  ]
}
