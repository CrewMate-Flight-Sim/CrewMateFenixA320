{
  "id": "before_takeoff",
  "name": "Before Takeoff",
  "sound_start": "cabin_takeoff.ogg",
  "sound_end": "ready.ogg",
  "steps": [
    {
      "label": "Pack 1",
      "read": "(L:S_OH_PNEUMATIC_PACK_1)",
      "on": "{pack1_cmd}",
      "expect": "{pack1_expect}"
    },
    {
      "label": "Pack 2",
      "read": "(L:S_OH_PNEUMATIC_PACK_2)",
      "on": "{pack2_cmd}",
      "expect": "{pack2_expect}"
    },
    {
      "label": "APU Bleed",
      "read": "(L:S_OH_PNEUMATIC_APU_BLEED)",
      "on": "{apu_bleed_cmd}",
      "expect": "{apu_bleed_expect}"
    },
    {
      "label": "Brake Fan",
      "read": "(L:S_MIP_BRAKE_FAN)",
      "on": "0 (>L:S_MIP_BRAKE_FAN)",
      "expect": 0,
      "only_if": {
        "read": "(L:B_CONFIG_BRAKEFANS)",
        "one_of": [1]
      }
    },
    {
      "label": "ND SET",
      "read": "(L:INI_MAP_RANGE_FO_SWITCH)",
      "on": "6 (>L:INI_MAP_RANGE_FO_SWITCH)",
      "expect": 6,
      "sound_on_execute": "appr_path_clear_of_tfc.ogg"
    },
    {
      "label": "Strobes",
      "read": "(L:INI_LIGHTS_STROBE)",
      "on": "0 (>L:INI_LIGHTS_STROBE)",
      "expect": 0,
      "only_if": {
        "option": "settings.lightsControlMode",
        "one_of": ["virtual"]
      }
    }
  ]
}
