{
  "id": "clear_left",
  "name": "Clear Left",
  "sound_start": "clear_right.ogg",
  "steps": [
    {
      "label": "Nose Light TAXI",
      "read": "(L:S_OH_EXT_LT_NOSE)",
      "on": "1 (>L:S_OH_EXT_LT_NOSE)",
      "expect": 1,
      "only_if": {
        "option": "settings.lightsControlMode",
        "one_of": ["virtual"]
      }
    },
    {
      "label": "Runway Turnoff Lights",
      "read": "(L:S_OH_EXT_LT_RWY_TURNOFF)",
      "on": "1 (>L:S_OH_EXT_LT_RWY_TURNOFF)",
      "expect": 1,
      "only_if": {
        "option": "settings.lightsControlMode",
        "one_of": ["virtual"]
      }
    }
  ]
}
