{
  "id": "after_landing",
  "name": "After Landing",
  "steps": [
    {
      "label": "Weather Radar OFF",
      "read": "(L:S_WR_SYS)",
      "on": "1 (>L:S_WR_SYS)",
      "expect": 1
    },
    {
      "label": "Predictive Windshear OFF",
      "read": "(L:S_WR_PRED_WS)",
      "on": "0 (>L:S_WR_PRED_WS)",
      "expect": 0
    },
    {
      "label": "Engine Mode NORM",
      "read": "(L:S_ENG_MODE)",
      "on": "1 (>L:S_ENG_MODE)",
      "expect": 1
    },
    {
      "label": "Flaps",
      "read": "(L:S_FC_FLAPS)",
      "on": "0 (>L:S_FC_FLAPS)",
      "expect": 0,
      "only_if": {
        "option": "landing.antiIce",
        "one_of": ["off"]
      }
    },
    {
      "label": "TCAS STBY",
      "read": "(L:S_XPDR_MODE)",
      "on": "0 (>L:S_XPDR_MODE)",
      "expect": 0
    },
    {
      "label": "APU Master ON",
      "read": "(L:S_OH_ELEC_APU_MASTER)",
      "on": "1 (>L:S_OH_ELEC_APU_MASTER)",
      "expect": 1,
      "wait_ms": 3000,
      "only_if": {
        "option": "landing.apuStart",
        "one_of": ["auto"]
      }
    },
    {
      "label": "APU Start",
      "read": "(L:I_OH_ELEC_APU_START_L)",
      "on": "S_OH_ELEC_APU_START",
      "expect": 1,
      "press": true,
      "only_if": [
        {
          "option": "landing.apuStart",
          "one_of": ["auto"]
        },
        {
          "read": "(L:I_OH_ELEC_APU_START_U)",
          "one_of": [0]
        }
      ]
    },
    {
      "label": "Engine 1 Anti Ice",
      "read": "(L:S_OH_PNEUMATIC_ENG1_ANTI_ICE)",
      "on": "{landing_anti_ice_eng1_cmd}",
      "expect": "{landing_anti_ice_eng1_expect}",
      "skip_delay": true
    },
    {
      "label": "Engine 2 Anti Ice",
      "read": "(L:S_OH_PNEUMATIC_ENG2_ANTI_ICE)",
      "on": "{landing_anti_ice_eng2_cmd}",
      "expect": "{landing_anti_ice_eng2_expect}"
    },
    {
      "label": "Landing Light Left",
      "read": "(L:S_OH_EXT_LT_LANDING_L)",
      "on": "0 (>L:S_OH_EXT_LT_LANDING_L)",
      "expect": 0,
      "only_if": {
        "option": "settings.lightsControlMode",
        "one_of": ["virtual"]
      }
    },
    {
      "label": "Landing Light Right",
      "read": "(L:S_OH_EXT_LT_LANDING_R)",
      "on": "0 (>L:S_OH_EXT_LT_LANDING_R)",
      "expect": 0,
      "only_if": {
        "option": "settings.lightsControlMode",
        "one_of": ["virtual"]
      }
    },
    {
      "label": "Strobes AUTO",
      "read": "(L:S_OH_EXT_LT_STROBE)",
      "on": "1 (>L:S_OH_EXT_LT_STROBE)",
      "expect": 1,
      "only_if": {
        "option": "settings.lightsControlMode",
        "one_of": ["virtual"]
      }
    },
    {
      "label": "Nose Light TAXI",
      "read": "(L:S_OH_EXT_LT_NOSE)",
      "on": "1 (>L:S_OH_EXT_LT_NOSE)",
      "expect": 1,
      "only_if": {
        "option": "settings.lightsControlMode",
        "one_of": ["virtual"]
      }
    }
  ]
}
