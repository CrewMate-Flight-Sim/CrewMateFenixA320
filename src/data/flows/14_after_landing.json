{
  "id": "after_landing",
  "name": "After Landing",
  "steps": [
    {
      "label": "Flaps",
      "read": "(L:S_FC_FLAPS)",
      "on": "0 (>L:S_FC_FLAPS)",
      "expect": 0,
      "only_if": {
        "option": "landing.antiIce",
        "one_of": ["off"]
      }
    },
    {
      "label": "LDG Flap 3",
      "read": "(L:S_OH_GPWS_LDG_FLAP3)",
      "on": "0 (>L:S_OH_GPWS_LDG_FLAP3)",
      "expect": 0
    },
    {
      "label": "APU",
      "read": "(L:INI_APU_MASTER_SWITCH)",
      "on": "1 (>L:INI_APU_MASTER_SWITCH)",
      "expect": 1,
      "only_if": {
        "option": "landing.apuStart",
        "one_of": ["auto"]
      }
    },
    {
      "label": "APU Start",
      "read": "(L:INI_APU_START_BUTTON)",
      "on": "1 (>L:INI_APU_START_BUTTON)",
      "expect": 1,
      "only_if": {
        "option": "landing.apuStart",
        "one_of": ["auto"]
      }
    },
    {
      "label": "Engine 1 Anti Ice",
      "read": "(L:S_OH_PNEUMATIC_ENG1_ANTI_ICE)",
      "on": "{landing_anti_ice_eng1_cmd}",
      "expect": "{landing_anti_ice_eng1_expect}",
      "skip_delay": true
    },
    {
      "label": "Engine 2 Anti Ice",
      "read": "(L:S_OH_PNEUMATIC_ENG2_ANTI_ICE)",
      "on": "{landing_anti_ice_eng2_cmd}",
      "expect": "{landing_anti_ice_eng2_expect}"
    },
    {
      "label": "Weather Radar",
      "read": "(L:S_WR_SYS)",
      "on": "1 (>L:S_WR_SYS)",
      "expect": 1
    },
    {
      "label": "Predictive Windshear",
      "read": "(L:S_WR_PRED_WS)",
      "on": "0 (>L:S_WR_PRED_WS)",
      "expect": 0
    },
    {
      "label": "Terrain Display",
      "read": "(L:INI_TERR_ON_FO)",
      "on": "0 (>L:INI_TERR_ON_FO)",
      "expect": 0
    },
    {
      "label": "Landing Lights",
      "read": "(L:INI_LIGHTS_LANDING)",
      "on": "0 (>L:INI_LIGHTS_LANDING)",
      "expect": 0,
      "only_if": {
        "option": "settings.lightsControlMode",
        "one_of": ["virtual"]
      }
    },
    {
      "label": "Strobes",
      "read": "(L:INI_LIGHTS_STROBE)",
      "on": "1 (>L:INI_LIGHTS_STROBE)",
      "expect": 1,
      "only_if": {
        "option": "settings.lightsControlMode",
        "one_of": ["virtual"]
      }
    },
    {
      "label": "Nose Wheel Light",
      "read": "(L:INI_LIGHTS_NOSE)",
      "on": "1 (>L:INI_LIGHTS_NOSE)",
      "expect": 1,
      "only_if": {
        "option": "settings.lightsControlMode",
        "one_of": ["virtual"]
      }
    }
  ]
}
