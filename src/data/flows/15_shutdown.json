{
  "id": "shutdown",
  "name": "Parking",
  "sound_end": "cabin_disarm_slides.ogg",
  "steps": [
    {
      "label": "Engine 1 Anti Ice",
      "read": "(L:S_OH_PNEUMATIC_ENG1_ANTI_ICE)",
      "on": "0 (>L:S_OH_PNEUMATIC_ENG1_ANTI_ICE)",
      "expect": 0,
      "skip_delay": true
    },
    {
      "label": "Engine 2 Anti Ice",
      "read": "(L:S_OH_PNEUMATIC_ENG2_ANTI_ICE)",
      "on": "0 (>L:S_OH_PNEUMATIC_ENG2_ANTI_ICE)",
      "expect": 0
    },
    {
      "label": "Wing Anti Ice",
      "read": "(L:S_OH_PNEUMATIC_WING_ANTI_ICE)",
      "on": "0 (>L:S_OH_PNEUMATIC_WING_ANTI_ICE)",
      "expect": 0
    },
    {
      "label": "APU Bleed ON",
      "read": "(L:S_OH_PNEUMATIC_APU_BLEED)",
      "on": "1 (>L:S_OH_PNEUMATIC_APU_BLEED)",
      "expect": 1,
      "only_if": {
        "read": "(L:I_OH_ELEC_APU_START_U)",
        "one_of": [1]
      }
    },
    {
      "label": "External Power ON",
      "read": "(L:I_OH_ELEC_EXT_PWR_L)",
      "on": "S_OH_ELEC_EXT_PWR",
      "expect": 1,
      "press": true,
      "only_if": {
        "read": "(L:I_OH_ELEC_EXT_PWR_U)",
        "one_of": [1]
      }
    },
    {
      "label": "Fuel Pump Left 1 OFF",
      "read": "(L:S_OH_FUEL_LEFT_1)",
      "on": "0 (>L:S_OH_FUEL_LEFT_1)",
      "expect": 0,
      "skip_delay": true
    },
    {
      "label": "Fuel Pump Left 2 OFF",
      "read": "(L:S_OH_FUEL_LEFT_2)",
      "on": "0 (>L:S_OH_FUEL_LEFT_2)",
      "expect": 0,
      "skip_delay": true
    },
    {
      "label": "Fuel Pump Center 1 OFF",
      "read": "(L:S_OH_FUEL_CENTER_1)",
      "on": "0 (>L:S_OH_FUEL_CENTER_1)",
      "expect": 0,
      "skip_delay": true
    },
    {
      "label": "Fuel Pump Center 2 OFF",
      "read": "(L:S_OH_FUEL_CENTER_2)",
      "on": "0 (>L:S_OH_FUEL_CENTER_2)",
      "expect": 0,
      "skip_delay": true
    },
    {
      "label": "Fuel Pump Right 1 OFF",
      "read": "(L:S_OH_FUEL_RIGHT_1)",
      "on": "0 (>L:S_OH_FUEL_RIGHT_1)",
      "expect": 0,
      "skip_delay": true
    },
    {
      "label": "Fuel Pump Right 2 OFF",
      "read": "(L:S_OH_FUEL_RIGHT_2)",
      "on": "0 (>L:S_OH_FUEL_RIGHT_2)",
      "expect": 0
    },
    {
      "label": "Transponder STBY",
      "read": "(L:S_XPDR_OPERATION)",
      "on": "0 (>L:S_XPDR_OPERATION)",
      "expect": 0
    },
    {
      "label": "Dome Light",
      "read": "(L:S_OH_INT_LT_DOME)",
      "on": "2 (>L:S_OH_INT_LT_DOME)",
      "expect": 2,
      "only_if": {
        "read": "(E:TIME OF DAY)",
        "one_of": [0, 2, 3]
      }
    },
    {
      "label": "FO LS OFF",
      "read": "(L:I_FCU_EFIS2_LS)",
      "on": "S_FCU_EFIS2_LS",
      "expect": 0,
      "press": true
    },
    {
      "label": "Cockpit Door",
      "read": "(L:S_COCKPIT_DOOR)",
      "on": "1 (>L:S_COCKPIT_DOOR)",
      "expect": 1
    }
  ]
}
