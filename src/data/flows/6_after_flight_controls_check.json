{
  "id": "after_flight_controls_check",
  "name": "Taxi",
  "steps": [
    {
      "label": "Auto Brake MAX",
      "read": "(L:I_MIP_AUTOBRAKE_MAX_L)",
      "on": "S_MIP_AUTOBRAKE_MAX",
      "expect": 1,
      "press": true
    },
    { "label": "Weather Radar SYS 1", "read": "(L:S_WR_SYS)", "on": "0 (>L:S_WR_SYS)", "expect": 0 },
    { "label": "Predictive Windshear AUTO", "read": "(L:S_WR_PRED_WS)", "on": "1 (>L:S_WR_PRED_WS)", "expect": 1 },
    {
      "label": "Terrain on ND",
      "read": "(L:I_MIP_GPWS_TERRAIN_ON_ND_FO_L)",
      "on": "S_MIP_GPWS_TERRAIN_ON_ND_FO",
      "expect": 1,
      "press": true
    },
    { "label": "Captain FD ON", "read": "(L:I_FCU_EFIS1_FD)", "on": "S_FCU_EFIS1_FD", "expect": 1, "press": true },
    { "label": "FO FD ON", "read": "(L:I_FCU_EFIS2_FD)", "on": "S_FCU_EFIS2_FD", "expect": 1, "press": true },
    {
      "label": "T.O CONFIG",
      "read": "(L:S_ECAM_TO)",
      "on": "S_ECAM_TO",
      "expect": 0,
      "press": true,
      "hold_ms": 1500,
      "skip_verify": true
    }
  ]
}
