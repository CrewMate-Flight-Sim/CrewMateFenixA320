{
  "id": "desc_ten_thousand_flow",
  "name": "Descend Ten Thousand Flow",
  "steps": [
    {
      "label": "Table",
      "read": "(L:S_TRAY_TABLE_FO)",
      "on": "0 (>L:S_TRAY_TABLE_FO)",
      "expect": 0
    },
    {
      "label": "Landing Light Left",
      "read": "(L:S_OH_EXT_LT_LANDING_L)",
      "on": "2 (>L:S_OH_EXT_LT_LANDING_L)",
      "expect": 2
    },
    {
      "label": "Landing Light Right",
      "read": "(L:S_OH_EXT_LT_LANDING_R)",
      "on": "2 (>L:S_OH_EXT_LT_LANDING_R)",
      "expect": 2
    },
    {
      "label": "Wing Lights",
      "read": "(L:S_OH_EXT_LT_WING)",
      "on": "1 (>L:S_OH_EXT_LT_WING)",
      "expect": 1
    },
    {
      "label": "Seat belts",
      "read": "(L:S_OH_SIGNS)",
      "on": "1 (>L:S_OH_SIGNS)",
      "expect": 1
    },
    {
      "label": "Terrain on ND ON",
      "read": "(L:I_MIP_GPWS_TERRAIN_ON_ND_FO_L)",
      "on": "S_MIP_GPWS_TERRAIN_ON_ND_FO",
      "expect": 1,
      "press": true
    },
    {
      "label": "FO CSTR",
      "read": "(L:I_FCU_EFIS2_CSTR)",
      "on": "S_FCU_EFIS2_CSTR",
      "press": true,
      "expect": 1
    },
    {
      "label": "ND SET",
      "read": "(L:S_FCU_EFIS2_ND_ZOOM)",
      "on": "0 (>L:S_FCU_EFIS2_ND_ZOOM)",
      "expect": 0
    },
    {
      "label": "FO LS",
      "read": "(L:I_FCU_EFIS2_LS)",
      "on": "S_FCU_EFIS2_LS",
      "press": true,
      "expect": "{landing_ls_expect}"
    }
  ]
}
