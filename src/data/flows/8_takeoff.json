{
  "id": "takeoff",
  "name": "Takeoff",
  "steps": [
    {
      "label": "Landing Light Left",
      "read": "(L:S_OH_EXT_LT_LANDING_L)",
      "on": "2 (>L:S_OH_EXT_LT_LANDING_L)",
      "expect": 2,
      "only_if": {
        "option": "settings.lightsControlMode",
        "one_of": ["virtual"]
      }
    },
    {
      "label": "Landing Light Right",
      "read": "(L:S_OH_EXT_LT_LANDING_R)",
      "on": "2 (>L:S_OH_EXT_LT_LANDING_R)",
      "expect": 2,
      "only_if": {
        "option": "settings.lightsControlMode",
        "one_of": ["virtual"]
      }
    },
    {
      "label": "Nose Light",
      "read": "(L:S_OH_EXT_LT_NOSE)",
      "on": "2 (>L:S_OH_EXT_LT_NOSE)",
      "expect": 2,
      "only_if": {
        "option": "settings.lightsControlMode",
        "one_of": ["virtual"]
      }
    },
    {
      "label": "Chrono",
      "read": "(L:S_MIP_CHRONO_FO)",
      "on": "S_MIP_CHRONO_FO",
      "press": true,
      "expect": 0,
      "skip_verify": true
    }
  ]
}
