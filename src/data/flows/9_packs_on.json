{
  "id": "packs_on",
  "name": "Packs on",
  "steps": [
    {
      "label": "Pack 1",
      "read": "(L:S_OH_PNEUMATIC_PACK_1)",
      "on": "1 (>L:S_OH_PNEUMATIC_PACK_1)",
      "expect": 1,
      "only_if": {
        "option": "takeoff.packs",
        "one_of": ["off"]
      }
    },
    {
      "label": "Pack 2",
      "read": "(L:S_OH_PNEUMATIC_PACK_2)",
      "on": "1 (>L:S_OH_PNEUMATIC_PACK_2)",
      "expect": 1,
      "sound_on_execute": "packs_1_and_2_on.ogg",
      "only_if": {
        "option": "takeoff.packs",
        "one_of": ["off"]
      }
    },
    {
      "label": "Chrono Stop",
      "read": "(L:S_MIP_CHRONO_FO)",
      "on": "S_MIP_CHRONO_FO",
      "press": true,
      "expect": 0,
      "wait_ms": 1000,
      "skip_verify": true
    },
    {
      "label": "Chrono Reset",
      "read": "(L:S_MIP_CHRONO_FO)",
      "on": "S_MIP_CHRONO_FO",
      "press": true,
      "expect": 0,
      "skip_verify": true
    }
  ]
}
