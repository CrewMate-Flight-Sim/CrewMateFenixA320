{
  "id": "packs_on",
  "name": "Packs on",
  "steps": [
    {
      "label": "pack 1",
      "read": "(L:INI_AIR_PACK1_BUTTON)",
      "on": "1 (>L:INI_AIR_PACK1_BUTTON)",
      "expect": 1
    },
    {
      "label": "pack 2",
      "read": "(L:INI_AIR_PACK2_BUTTON)",
      "on": "1 (>L:INI_AIR_PACK2_BUTTON)",
      "expect": 1,
      "sound_on_execute": "packs_1_and_2_on.ogg"
    },
    {
      "label": "Chrono Stop",
      "read": "(L:S_MIP_CHRONO_FO)",
      "on": "S_MIP_CHRONO_FO",
      "press": true,
      "expect": 0,
      "wait_ms": 1000,
      "skip_verify": true
    },
    {
      "label": "Chrono Reset",
      "read": "(L:S_MIP_CHRONO_FO)",
      "on": "S_MIP_CHRONO_FO",
      "press": true,
      "expect": 0,
      "skip_verify": true
    }
  ]
}
