{
  "id": "shutdown_eng2",
  "name": "Shutdown Engine 2",
  "sound_start": "check.ogg",
  "steps": [
    {
      "label": "Engine 2 Anti Ice",
      "read": "(L:S_OH_PNEUMATIC_ENG2_ANTI_ICE)",
      "on": "0 (>L:S_OH_PNEUMATIC_ENG2_ANTI_ICE)",
      "expect": 0
    },
    {
      "label": "Engine 2 Master OFF",
      "read": "(L:S_ENG_MASTER_2)",
      "on": "0 (>L:S_ENG_MASTER_2)",
      "expect": 0
    },
    {
      "label": "Yellow Elec Pump ON",
      "read": "(L:S_OH_HYD_YELLOW_ELEC_PUMP)",
      "on": "1 (>L:S_OH_HYD_YELLOW_ELEC_PUMP)",
      "expect": 1
    }
  ]
}
