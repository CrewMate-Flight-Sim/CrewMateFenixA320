{
  "id": "after_start",
  "name": "After Start",
  "steps": [
    {
      "label": "Ground Spoilers",
      "read": "(L:A_FC_SPEEDBRAKE)",
      "on": "0 (>L:A_FC_SPEEDBRAKE)",
      "expect": 0
    },
    {
      "label": "Rudder Trim Reset",
      "read": "(L:S_FC_RUDDER_TRIM_RESET)",
      "on": "S_FC_RUDDER_TRIM_RESET",
      "press": true,
      "expect": 0,
      "skip_verify": true
    },
    {
      "label": "Flaps {flaps}",
      "read": "(L:S_FC_FLAPS)",
      "on": "{flaps} (>L:S_FC_FLAPS)",
      "expect": "{flaps}",
      "flaps_lever": true,
      "only_if": {
        "option": "takeoff.antiIce",
        "one_of": ["off"]
      }
    },
    {
      "label": "Pitch Trim",
      "read": "(L:A_FC_ELEVATOR_TRIM)",
      "on": "{pitch_trim} (>L:A_FC_ELEVATOR_TRIM)",
      "expect": "{pitch_trim}"
    },
    {
      "label": "ECAM Status",
      "read": "(L:I_ECAM_STATUS)",
      "on": "S_ECAM_STATUS",
      "press": true,
      "expect": 1
    },
    {
      "label": "Dome off",
      "read": "(L:S_OH_INT_LT_DOME)",
      "on": "0 (>L:S_OH_INT_LT_DOME)",
      "expect": 0
    }
  ]
}
