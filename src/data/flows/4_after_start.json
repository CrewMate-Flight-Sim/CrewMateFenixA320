{
  "id": "after_start",
  "name": "After Start",
  "steps": [
    {
      "label": "Ground Spoilers",
      "read": "(L:A_FC_SPEEDBRAKE)",
      "on": "0 (>L:A_FC_SPEEDBRAKE)",
      "expect": 0
    },
    {
      "label": "Reset Rudder Trim",
      "read": "(L:RUDDER_TRIM_RESET_REQ)",
      "on": "1 (>L:RUDDER_TRIM_RESET_REQ)",
      "expect": 1,
      "skip_verify": true
    },
    {
      "label": "Flaps {flaps}",
      "read": "(L:S_FC_FLAPS)",
      "on": "{flaps} (>L:S_FC_FLAPS)",
      "expect": "{flaps}",
      "flaps_lever": true,
      "only_if": {
        "option": "takeoff.antiIce",
        "one_of": ["off"]
      }
    },
    {
      "label": "Dome off",
      "read": "(L:INI_CKPT_LT_DOME)",
      "on": "0 (>L:INI_CKPT_LT_DOME)",
      "expect": 0
    }
  ]
}
